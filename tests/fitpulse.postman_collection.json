                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde con código 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('userId', pm.response.json().id);",
                  "pm.test('No expone la contraseña', function () { pm.expect(pm.response.json()).to.not.have.property('password'); });"
                ]
